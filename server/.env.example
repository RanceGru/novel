# ============================================================
# 环境变量示例 — 复制为 server/.env 后按需修改
# ============================================================

# ---------- 数据库 ----------
# 驱动选择：postgres | sqlite
#   postgres = PostgreSQL 16（推荐，生产/联调目标）
#   sqlite   = 本地零配置回退，仅限开发
DB_TYPE=postgres

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=novel
DB_PASSWORD=novel_dev_password
DB_DATABASE=novel_writing

# ---------- Redis（缓存 / 队列）----------
# 未启动 Redis 时会自动降级为进程内内存缓存，功能可用但不跨实例共享
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ---------- 服务 ----------
PORT=3000
NODE_ENV=development
# 前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173

# ---------- 认证 ----------
# 生产环境必须设置，否则启动即报错
JWT_SECRET=please-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m

# ---------- AI Provider ----------
# 对话生成（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_FLASH_MODEL=deepseek-chat
DEEPSEEK_PRO_MODEL=deepseek-reasoner

# 向量嵌入（OpenAI）
# 注意：与对话模型是两套 Key。未配置时 EmbeddingService 返回全零向量，
# 记忆检索将失效（且 pgvector 不为零向量建立余弦索引）。
OPENAI_API_KEY=

# ============================================================
# pgvector 启用说明（当前无需安装，接口已预留）
# ============================================================
# 当前向量列以 simple-json(text) 存储，向量检索走 JS 余弦回退，因此
# 使用纯 PostgreSQL 16 镜像即可跑通全部功能。
#
# 待需要原生向量检索时，按以下顺序执行：
#   1. 更换镜像或在实例上安装 pgvector 扩展：
#        image: pgvector/pgvector:pg16
#        CREATE EXTENSION IF NOT EXISTS vector;
#   2. 迁移向量列：
#        ALTER TABLE memory_events ALTER COLUMN embedding TYPE vector(1536) USING embedding::vector;
#        ALTER TABLE setting_patches ALTER COLUMN embedding TYPE vector(1536) USING embedding::vector;
#        ALTER TABLE style_anchors  ALTER COLUMN embedding TYPE vector(1536) USING embedding::vector;
#   3. 建立 HNSW 索引（支持增量写入，无需 IVFFlat 的 lists 预训练）：
#        CREATE INDEX ON memory_events USING hnsw (embedding vector_cosine_ops);
#   4. 中文全文检索需另装 zhparser 扩展（pgvector 官方镜像不含），
#      并将 chinese 配置指向它：CREATE TEXT SEARCH CONFIGURATION chinese (PARSER = zhparser);
#      否则 VectorSearchService 的 ts_rank 分支仍会失败回退。
