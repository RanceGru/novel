{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "@novel/shared": ["../../shared/src"]
    },
    "noEmit": true
  },
  "include": ["src/**/*", "electron/**/*", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
