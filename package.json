{
  "name": "novel-writing-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "AI智能小说生成助手 — 500万字级网文创作桌面软件",
  "scripts": {
    "dev:server": "pnpm --filter @novel/server dev",
    "dev:client": "pnpm --filter @novel/client dev",
    "build:shared": "pnpm --filter @novel/shared build",
    "build:server": "pnpm --filter @novel/server build",
    "build:client": "pnpm --filter @novel/client build",
    "build": "pnpm build:shared && pnpm build:server && pnpm build:client",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @novel/server db:migrate",
    "db:migrate:generate": "pnpm --filter @novel/server db:migrate:generate",
    "db:migrate:revert": "pnpm --filter @novel/server db:migrate:revert",
    "db:seed": "pnpm --filter @novel/server db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "clean": "pnpm -r clean && rimraf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0"
  }
}
